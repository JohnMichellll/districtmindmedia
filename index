<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>District Mind Media</title>
    <meta
      name="description"
      content="District Mind Media — independent music, artist features, new releases, culture, interviews, and entertainment."
    />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="nav-container">
        <a href="index" class="logo">DISTRICT MIND</a>

        <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav">
          Menu
        </button>

        <nav class="primary-nav" id="primary-nav">
          <a href="index">Home</a>
          <a href="#latest">Latest</a>
          <a href="#releases">Releases</a>
          <a href="artists">Artists</a>
          <a href="about">About</a>
          <a href="contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">District Mind Media</p>

          <h1>The culture<br />in motion.</h1>

          <p class="hero-text">
            Music, artists, releases, and stories worth paying attention to.
          </p>

          <div class="hero-actions">
            <a href="#latest" class="hero-button">Explore Media</a>
            <a href="artists" class="hero-button secondary">View Artists</a>
          </div>
        </div>
      </section>

      <section id="latest" class="section featured-section">
        <div class="section-heading">
          <p class="eyebrow">01 / Latest</p>
          <h2>What's happening.</h2>
        </div>

        <div class="featured-card">
          <div class="card-placeholder">
            <span>Featured Story</span>
          </div>

          <div class="card-content">
            <p class="category">Music</p>
            <h3>New music. New artists. New energy.</h3>
            <p>
              District Mind Media covers the releases and artists moving culture
              forward.
            </p>
            <a href="#">Read Story →</a>
          </div>
        </div>
      </section>

      <section class="section editorial-grid">
        <article class="editorial-card editorial-large">
          <div class="editorial-image image-one">
            <span>Artist Feature</span>
          </div>
          <div class="editorial-copy">
            <p class="category">Culture</p>
            <h3>Independent voices shaping the next wave.</h3>
            <p>
              From rising producers to fearless creatives, the next chapter is
              being written far from the center of the noise.
            </p>
          </div>
        </article>

        <article class="editorial-card">
          <div class="editorial-image image-two">
            <span>Interview</span>
          </div>
          <div class="editorial-copy compact">
            <p class="category">Interview</p>
            <h3>Creative instincts over trends.</h3>
          </div>
        </article>

        <article class="editorial-card">
          <div class="editorial-image image-three">
            <span>Review</span>
          </div>
          <div class="editorial-copy compact">
            <p class="category">Review</p>
            <h3>What’s resonating right now.</h3>
          </div>
        </article>
      </section>

      <section id="releases" class="section">
        <div class="section-heading">
          <p class="eyebrow">02 / Releases</p>
          <h2>Coming this Friday.</h2>
        </div>

        <div class="release-grid">
          <article class="release-card">
            <div class="release-image art-one">
              <span>Maya Sol</span>
            </div>
            <p class="category">New Release</p>
            <h3>Afterglow</h3>
            <p>Warm, intimate production with deep emotional pull.</p>
          </article>

          <article class="release-card">
            <div class="release-image art-two">
              <span>Kairo Lane</span>
            </div>
            <p class="category">New Release</p>
            <h3>Pressure</h3>
            <p>Sharp delivery and cinematic tension built for motion.</p>
          </article>

          <article class="release-card">
            <div class="release-image art-three">
              <span>Vanta Drift</span>
            </div>
            <p class="category">New Release</p>
            <h3>Static Hearts</h3>
            <p>Dark textures and urgent rhythm for late-night listening.</p>
          </article>
        </div>
      </section>

      <section class="section spotlight-banner">
        <div class="spotlight-banner-inner">
          <div>
            <p class="eyebrow">Editors' pick</p>
            <h2>The sound of the city, told through stories.</h2>
          </div>
          <a href="about">Read the story →</a>
        </div>
      </section>

      <section id="artists" class="section dark-section">
        <div class="section-heading">
          <p class="eyebrow">03 / Artists</p>
          <h2>Know the names.</h2>
        </div>

        <div class="artist-feature">
          <div>
            <p class="category">Artist Spotlight</p>
            <h3>Independent voices deserve a spotlight.</h3>
            <p>
              Discover artists creating their own lane and building something
              bigger than themselves.
            </p>
          </div>

          <a href="artists">View Artists →</a>
        </div>
      </section>

      <section id="culture" class="section">
        <div class="section-heading">
          <p class="eyebrow">04 / Culture</p>
          <h2>More than music.</h2>
        </div>

        <div class="culture-grid">
          <div class="culture-card">
            <p class="category">Culture</p>
            <h3>The mindset behind the movement.</h3>
          </div>

          <div class="culture-card">
            <p class="category">Media</p>
            <h3>Stories from the people creating what's next.</h3>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-container">
        <div>
          <h3>District Mind</h3>
          <p>Media</p>
        </div>

        <p>© 2026 District Mind Media. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.primary-nav');

      if (menuToggle && nav) {
        menuToggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('is-open');
          menuToggle.setAttribute('aria-expanded', String(isOpen));
        });

        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            nav.classList.remove('is-open');
            menuToggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>
